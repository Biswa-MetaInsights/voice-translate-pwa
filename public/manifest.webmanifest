{
  "name": "Voice Translate",
  "short_name": "VoiceTranslate",
  "description": "Live voice transcription and AI translation in a simple installable app.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#f3fbfa",
  "theme_color": "#0f766e",
