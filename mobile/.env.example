# Public address only. Never put Gateway/Meta keys in mobile configuration.
# Deploy this branch's API to a separate test backend before real-device testing.
MOBILE_BACKEND_ORIGIN=https://YOUR-MOBILE-PREVIEW.vercel.app
# Production hosts require an additional deliberate build-time acknowledgement.
# MOBILE_ALLOW_PRODUCTION_BACKEND=true
# Backend environment, not app environment:
# MOBILE_API_ENABLED=true
# VOICE_NOTE_UPLOAD_ENABLED=true
# MOBILE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# MOBILE_SUPABASE_SECRET_KEY=server-only-secret-key
# MOBILE_LIMIT_KEY=server-only-random-secret-at-least-32-characters
# MOBILE_REQUESTS_PER_MINUTE=120
# MOBILE_REQUESTS_PER_DAY=10000
# Configure provider spend caps independently; request budgets are not currency caps.
# Signing variables belong to your private build environment only:
# ANDROID_KEYSTORE_PATH=/private/path/upload.jks
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
# MOBILE_RELEASE_VERSION_CODE=1
# MOBILE_RELEASE_APPROVED=true
